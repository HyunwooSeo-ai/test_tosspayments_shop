# NINE STORE 환경 변수 예시. .env로 복사해서 씁니다.
# 이 프로젝트는 빌드 도구가 없어 화면(js/*.js)은 이 파일을 읽지 않습니다.
# 화면용 공개 값은 js/supabase.js, js/checkout.js에 그대로 둡니다.

# --- 공개 값 (참고용) ---
SUPABASE_URL=https://dyfieegfgskszpyldhzs.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_6CYWcAoFrPU3LZ3MmoKgPA_uOfs8_MP
TOSS_CLIENT_KEY=test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm

# --- Edge Function secret ---
# 비워 두면 Edge Function이 문서 공개 테스트 키(test_gsk_docs_...)를 씁니다.
# 내 상점 키를 쓰려면 개발자센터의 시크릿 키(test_gsk_... / test_sk_...)를 넣고
# Supabase 대시보드 Edge Functions > Secrets에 같은 이름으로 등록합니다.
TOSS_SECRET_KEY=

# --- 챗봇 Edge Function secret (chat, embed-products) ---
# Supabase 대시보드 Edge Functions > Secrets에 같은 이름으로 등록해야 동작합니다.
OPENAI_API_KEY=
UPSTAGE_API_KEY=
# 비워 두면 gpt-5-mini
OPENAI_MODEL=
